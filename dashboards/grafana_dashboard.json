    {
      "id": 6,
      "type": "timeseries",
      "title": "$metric ($stat) on node $node: Spark hourly aggregates",
      "description": "Red regions: Nagios reports the node as drained. Markers: flags raised by the selected detector.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT window_start AS time, avg_value AS \"hourly avg\", min_value AS \"hourly min\", max_value AS \"hourly max\"\nFROM metric_agg_1h\nWHERE $__timeFilter(window_start) AND node_id = '$node' AND metric = '$metric' AND stat = '$stat'\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": []
      }
    },

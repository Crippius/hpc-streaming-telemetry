          "rawSql": "SELECT event_time AS time, count(*) FILTER (WHERE is_anomaly) AS \"drained nodes\"\nFROM anomaly_scores\nWHERE $__timeFilter(event_time) AND detector = 'nagios_oracle'\nGROUP BY 1 ORDER BY 1"
        }

          "rawSql": "SELECT $__timeGroupAlias(event_time, 1h), count(*) FILTER (WHERE flagged) AS \"$detector flags\"\nFROM anomaly_scores\nWHERE $__timeFilter(event_time) AND detector = '$detector'\nGROUP BY 1 ORDER BY 1"

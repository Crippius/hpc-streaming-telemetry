          "rawSql": "SELECT event_time AS time, score AS \"score\", threshold AS \"threshold\"\nFROM anomaly_scores\nWHERE $__timeFilter(event_time) AND detector = '$detector' AND node_id = '$node'\nORDER BY 1"

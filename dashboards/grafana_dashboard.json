          "rawSql": "SELECT window_start AS time, sum(avg_value) / 1000 AS \"cluster power (kW)\"\nFROM metric_agg_1h\nWHERE $__timeFilter(window_start) AND metric = 'total_power' AND stat = 'avg'\nGROUP BY 1 ORDER BY 1"

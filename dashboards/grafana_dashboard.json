  "annotations": {
    "list": [
      {
        "name": "Nagios drained",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "enable": true,
        "iconColor": "rgba(242, 73, 92, 0.25)",
        "target": {
          "refId": "Anno",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH a AS (\n  SELECT event_time,\n         event_time - (row_number() OVER (ORDER BY event_time)) * interval '15 minutes' AS grp\n  FROM anomaly_scores\n  WHERE detector = 'nagios_oracle' AND node_id = '$node' AND is_anomaly AND $__timeFilter(event_time)\n)\nSELECT min(event_time) AS time, max(event_time) + interval '15 minutes' AS timeend,\n       'Nagios: node drained (' || count(*) || ' windows)' AS text\nFROM a GROUP BY grp ORDER BY 1"
        },
        "filter": {
          "exclude": false,
          "ids": [
            6,
            7
          ]
        }
      },
      {
        "name": "Detector flags",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "enable": true,
        "iconColor": "rgba(255, 152, 48, 0.35)",
        "target": {
          "refId": "Anno",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "WITH f AS (\n  SELECT event_time, score,\n         event_time - (row_number() OVER (ORDER BY event_time)) * interval '15 minutes' AS grp\n  FROM anomaly_scores\n  WHERE detector = '$detector' AND node_id = '$node' AND flagged AND $__timeFilter(event_time)\n)\nSELECT min(event_time) AS time, max(event_time) + interval '15 minutes' AS timeend,\n       '$detector: ' || count(*) || ' flagged window(s), max score ' || round(max(score)::numeric, 3) AS text\nFROM f GROUP BY grp ORDER BY 1"
        },
        "filter": {
          "exclude": false,
          "ids": [
            6,
            7
          ]
        }
      }
    ]
  },

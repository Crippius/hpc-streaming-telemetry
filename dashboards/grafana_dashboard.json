    {
      "id": 10,
      "type": "timeseries",
      "title": "Spark latency: Kafka publish to hourly aggregate written",
      "description": "Wall-clock delay from the producer's Kafka timestamp to the hourly aggregate landing in TimescaleDB, by event time.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(window_start, 6h),\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM written_at - last_publish_time)) AS \"Spark write p50\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM written_at - last_publish_time)) AS \"Spark write p95\"\nFROM metric_agg_1h WHERE $__timeFilter(window_start)\nGROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "unit": "s"
        },
        "overrides": []
      }
    }
